{
  "name": "@iart/backend-sdk",
  "private": true,
  "version": "0.0.0",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./electron-bridge": {
      "types": "./dist/electron-bridge.d.ts",
      "default": "./dist/electron-bridge.js"
    },
    "./electron-bridge/types": {
      "types": "./dist/electron-bridge/types.d.ts",
      "default": "./dist/electron-bridge/types.js"
    },
    "./hub-fetch-target-resolver": {
      "types": "./dist/hub-fetch-target-resolver.d.ts",
      "default": "./dist/hub-fetch-target-resolver.js"
    }
  },
  "dependencies": {
    "@iart/contracts": "workspace:*"
  },
  "scripts": {
    "build": "node ../../tooling/build/up-to-date-runner.mjs @iart/backend-sdk --workspace-deps -- \"node ../../tooling/build/clean-dist.mjs dist && tsc -p tsconfig.json\""
  }
}
