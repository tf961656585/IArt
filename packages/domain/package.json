{
  "name": "@iart/domain",
  "private": true,
  "version": "0.0.0",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./api-key-groups": {
      "types": "./dist/api-key-groups.d.ts",
      "default": "./dist/api-key-groups.js"
    },
    "./project-naming": {
      "types": "./dist/project-naming.d.ts",
      "default": "./dist/project-naming.js"
    }
  },
  "dependencies": {
    "@iart/contracts": "workspace:*"
  },
  "scripts": {
    "build": "node ../../tooling/build/up-to-date-runner.mjs @iart/domain --workspace-deps -- \"node ../../tooling/build/clean-dist.mjs dist && tsc -p tsconfig.json\""
  }
}
