{
  "name": "iartstudio-frontend",
  "private": true,
  "version": "0.6.6",
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "main": "apps/desktop-shell/dist/main.cjs",
  "scripts": {
    "dev": "pnpm --filter @iart/editor dev",
    "dev:watch": "tsx tooling/dev/watch-model-discovery.ts",
    "dev:full": "pnpm generate:model-discovery && concurrently \"pnpm dev:watch\" \"pnpm dev\"",
    "prebuild": "tsx tooling/scripts/generate-model-auto-discovery.ts",
    "build": "pnpm check:preflight",
    "build:hub": "node ./tooling/build/build-hub-static.mjs",
    "build:editor": "node ./tooling/build/build-editor-static.mjs",
    "build:packages": "pnpm --filter @iart/contracts build && pnpm --filter @iart/ui build && pnpm --filter @iart/model-asset-runtime build && pnpm --filter @iart/domain build && pnpm --filter @iart/backend-sdk build && pnpm --filter @iart/utils build && pnpm --filter @iart/chat-adapter build",
    "build:typecheck-deps": "pnpm build:packages && pnpm --filter @iart/backend build && pnpm --filter @iart/desktop-shell build",
    "build:desktop-static": "node ./tooling/build/build-desktop-static.mjs",
    "generate:mac-icon": "node ./tooling/build/generate-mac-icon.mjs",
    "ensure:electron": "node ./tooling/dev/ensure-electron.mjs",
    "lint:dock-media": "node tooling/scripts/lint-dock-media.mjs",
    "lint": "node --max-old-space-size=6144 ./node_modules/eslint/bin/eslint.js . --max-warnings=0 --cache --cache-location node_modules/.cache/eslint/eslint-cache --cache-strategy content && pnpm guard:jsx-aschild-children && pnpm guard:code-file-lines",
    "diagnose:gates": "node ./tooling/scripts/diagnose-gates.mjs",
    "diagnose:model-catalog": "node --import tsx ./tooling/scripts/diagnose-model-catalog.mjs",
    "lint:model-ports": "tsx tooling/scripts/validate-model-ports.ts",
    "guard:editor-remote-model-static-truth": "node ./tooling/scripts/guard-editor-remote-model-static-truth.mjs",
    "guard:jsx-aschild-children": "node ./tooling/scripts/guard-jsx-aschild-children.mjs",
    "guard:code-file-lines": "node ./tooling/scripts/guard-code-file-lines.mjs",
    "guard:stable-business-types": "node ./tooling/scripts/guard-stable-business-types.mjs",
    "validate:filenames": "node ./tooling/scripts/validate-filenames.mjs",
    "check:sql-columns": "bash scripts/check-sql-columns.sh",
    "generate:model-discovery": "tsx tooling/scripts/generate-model-auto-discovery.ts",
    "build:model-asset-packages": "pnpm --filter @iart/contracts build && pnpm --filter @iart/model-asset-runtime build && tsx tooling/scripts/build-model-asset-packages.ts",
    "validate:models": "tsx tooling/scripts/validate-model-index.ts",
    "typecheck": "pnpm typecheck:workspaces",
    "typecheck:workspaces": "tsc -p packages/contracts/tsconfig.json --pretty --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/contracts.tsbuildinfo && tsc -p packages/model-asset-runtime/tsconfig.json --pretty --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/model-asset-runtime.tsbuildinfo && tsc -p packages/domain/tsconfig.json --pretty --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/domain.tsbuildinfo && tsc -p packages/backend-sdk/tsconfig.json --pretty --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/backend-sdk.tsbuildinfo && tsc -p packages/utils/tsconfig.json --pretty --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/utils.tsbuildinfo && tsc -p apps/backend/tsconfig.typecheck.json --pretty --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/backend-typecheck.tsbuildinfo && tsc -p apps/desktop-shell/tsconfig.json --pretty --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/desktop-shell.tsbuildinfo && tsc -p apps/editor/tsconfig.json --pretty --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/editor.tsbuildinfo && tsc -p apps/hub/tsconfig.json --pretty --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/hub.tsbuildinfo && tsc -p tooling/tsconfig.json --pretty --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/tooling.tsbuildinfo",
    "check:types-and-boundaries": "pnpm build:typecheck-deps && pnpm typecheck:workspaces && pnpm lint && pnpm guard:stable-business-types && pnpm guard:canvas-selection-ownership && pnpm guard:dialog-sizing && pnpm guard:media-fit-contain && pnpm guard:elevation-z && pnpm guard:escape-stack && pnpm guard:css-undefined-vars && pnpm guard:css-size-tokens && pnpm guard:button-standard && pnpm guard:spec-test-linkage",
    "test": "node ./tooling/scripts/validate-filenames.mjs && pnpm abi:node -- --verify && pnpm build && vitest run",
    "test:integration": "pnpm abi:node -- --verify && pnpm build && vitest run testing/integration",
    "test:watch": "vitest",
    "test:scripts": "pnpm --filter @iart/contracts build && node --test ./tooling/scripts/__tests__/*.test.mjs",
    "test:backend": "node --import tsx --test \"apps/backend/src/**/__tests__/*.test.ts\"",
    "clean": "node ./tooling/scripts/clean.js",
    "backend:dev": "pnpm abi:node -- --verify && pnpm --filter @iart/contracts build && pnpm --filter @iart/domain build && pnpm --filter @iart/utils build && pnpm build:model-asset-packages && pnpm --filter @iart/backend build && node ./apps/backend/dist/main.cjs",
    "desktop:dev": "pnpm check:preflight && pnpm desktop:run-built",
    "desktop:dev:debug": "node ./tooling/dev/desktop-dev-debug.mjs",
    "ensure:desktop-deps": "node ./tooling/dev/ensure-desktop-deps.mjs",
    "ensure:desktop-deps:x64": "node ./tooling/dev/ensure-desktop-deps.mjs --target-arch x64",
    "desktop:dev:latest": "pnpm desktop:dev",
    "desktop:pack": "pnpm check:preflight && pnpm clean:desktop-artifacts && electron-builder --dir && pnpm verify:packaged-native-runtimes",
    "desktop:dist": "pnpm desktop:dist:win:x64",
    "desktop:dist:win:x64": "pnpm check:preflight && pnpm clean:desktop-artifacts && electron-builder --win --x64 --publish never && pnpm verify:packaged-native-runtimes",
    "desktop:dist:mac": "pnpm check:preflight && pnpm run generate:mac-icon && pnpm clean:desktop-artifacts && electron-builder --mac --arm64 --publish never && pnpm verify:packaged-native-runtimes",
    "desktop:dist:mac:zip": "pnpm check:preflight && pnpm run generate:mac-icon && pnpm clean:desktop-artifacts && electron-builder --mac zip --arm64 --publish never && pnpm verify:packaged-native-runtimes",
    "desktop:dist:mac:arm64": "pnpm check:preflight && pnpm run generate:mac-icon && pnpm clean:desktop-artifacts && electron-builder --mac --arm64 --publish never -c.mac.identity=null && pnpm verify:packaged-native-runtimes",
    "desktop:dist:mac:x64": "pnpm check:preflight && pnpm ensure:desktop-deps:x64 && pnpm run generate:mac-icon && pnpm clean:desktop-artifacts && electron-builder --mac --x64 --publish never && pnpm verify:packaged-native-runtimes",
    "verify:local-backend": "node ./tooling/scripts/verify-local-backend.mjs",
    "verify:desktop-smoke": "node ./tooling/scripts/verify-desktop-smoke.mjs",
    "verify:packaged-native-runtimes": "node ./tooling/scripts/verify-packaged-native-runtimes.mjs",
    "verify:hub-title-band": "node ./tooling/scripts/verify-hub-title-band.mjs",
    "verify:settings-density": "node ./tooling/scripts/verify-settings-density.mjs",
    "clean:desktop-artifacts": "node ./tooling/scripts/clean-desktop-artifacts.mjs",
    "abi:node": "node ./tooling/scripts/switch-abi.mjs node",
    "abi:electron": "node ./tooling/scripts/switch-abi.mjs electron",
    "sqlite:prepare": "node ./tooling/scripts/switch-abi.mjs --all",
    "sqlite:prepare:x64": "node ./tooling/scripts/switch-abi.mjs --all --arch x64",
    "gen:ui": "hygen component ui",
    "gen:feature": "hygen component feature",
    "build:desktop-runtime": "pnpm build:model-asset-packages && pnpm --filter @iart/backend build && pnpm --filter @iart/desktop-shell build && pnpm build:desktop-static",
    "guard:no-internal-timeout": "node ./tooling/scripts/guard-no-internal-timeout.mjs",
    "guard:ipc-contract-parse": "node ./tooling/scripts/guard-ipc-contract-parse.mjs",
    "guard:contract-ownership": "node ./tooling/scripts/guard-contract-ownership.mjs",
    "guard:public-relay-capabilities": "node ./tooling/scripts/guard-public-relay-capabilities.mjs",
    "guard:no-runtime-json-leak": "node ./tooling/scripts/guard-no-runtime-json-leak.mjs",
    "guard:no-json-clone": "node ./tooling/scripts/guard-no-json-clone.mjs",
    "guard:desktop-runtime-deps": "node ./tooling/scripts/guard-desktop-runtime-deps.mjs",
    "guard:canvas-selection-ownership": "node ./tooling/scripts/guard-canvas-selection-ownership.mjs",
    "guard:dialog-sizing": "node ./tooling/scripts/guard-dialog-sizing.mjs",
    "guard:media-fit-contain": "node ./tooling/scripts/guard-media-fit-contain.mjs",
    "guard:elevation-z": "node ./tooling/scripts/guard-elevation-z.mjs",
    "guard:escape-stack": "node ./tooling/scripts/guard-escape-stack.mjs",
    "guard:css-undefined-vars": "node ./tooling/scripts/guard-css-undefined-vars.mjs",
    "guard:css-size-tokens": "node ./tooling/scripts/guard-css-size-tokens.mjs",
    "guard:button-standard": "node ./tooling/scripts/guard-button-standard.mjs",
    "guard:spec-test-linkage": "node ./tooling/scripts/guard-spec-test-linkage.mjs",
    "guard:media-input-source-kind-coverage": "node ./tooling/scripts/guard-media-input-source-kind-coverage.mjs",
    "guard:no-media-input-downgrade": "node ./tooling/scripts/guard-no-media-input-downgrade.mjs",
    "guard:model-input-modalities": "node ./tooling/scripts/guard-model-input-modalities-consistency.mjs",
    "guard:no-structural-fields-in-normalized-arguments": "node ./tooling/scripts/guard-no-structural-fields-in-normalized-arguments.mjs",
    "guard:nested-formdata-body-handled": "node ./tooling/scripts/guard-nested-formdata-body-handled.mjs",
    "guard:local-media-url-resolution": "node ./tooling/scripts/guard-local-media-url-resolution.mjs",
    "check:preflight": "pnpm check:types-and-boundaries && pnpm test:scripts && pnpm guard:no-internal-timeout && pnpm guard:ipc-contract-parse && pnpm guard:contract-ownership && pnpm guard:media-input-source-kind-coverage && pnpm guard:no-media-input-downgrade && pnpm guard:model-input-modalities && pnpm guard:no-structural-fields-in-normalized-arguments && pnpm guard:nested-formdata-body-handled && pnpm guard:no-runtime-json-leak && pnpm guard:no-json-clone && pnpm guard:local-media-url-resolution && pnpm guard:desktop-runtime-deps && pnpm ensure:desktop-deps && pnpm build:desktop-runtime && pnpm guard:public-relay-capabilities && pnpm verify:desktop-smoke",
    "diagnose:preflight": "node ./tooling/scripts/diagnose-preflight.mjs",
    "desktop:run-built": "pnpm ensure:desktop-deps && electron ./apps/desktop-shell/dist/main.cjs",
    "desktop:dev:fast": "pnpm build:desktop-runtime && pnpm desktop:run-built"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@iart/backend-sdk": "workspace:*",
    "@iart/chat-adapter": "workspace:*",
    "@iart/contracts": "workspace:*",
    "@iart/domain": "workspace:*",
    "@iart/model-asset-runtime": "workspace:*",
    "@iart/utils": "workspace:*",
    "better-sqlite3": "^12.6.2",
    "busboy": "^1.6.0",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.9",
    "elkjs": "0.11.1",
    "ffmpeg-static": "^5.3.0",
    "jszip": "^3.10.1",
    "koffi": "^3.3.3",
    "sharp": "^0.34.5",
    "undici": "7.16.0",
    "ws": "^8.19.0",
    "yauzl": "^2.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@eslint/js": "9.39.1",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@tabler/icons-react": "^3.35.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@tanstack/react-query": "^5.66.9",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/dompurify": "^3.0.5",
    "@types/js-yaml": "4.0.9",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.182.0",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "@xyflow/react": "^12.9.3",
    "ai": "^5.0.93",
    "autoprefixer": "^10.4.22",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "concurrently": "^9.2.1",
    "dompurify": "^3.3.0",
    "electron": "^39.2.7",
    "electron-builder": "^24.13.3",
    "electron-devtools-installer": "^4.0.0",
    "embla-carousel-react": "^8.6.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.2",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "fake-indexeddb": "^6.2.5",
    "file-saver": "^2.0.5",
    "hygen": "^6.2.11",
    "i18next": "^25.4.1",
    "immer": "^11.0.0",
    "js-yaml": "4.1.1",
    "jsdom": "^25.0.1",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "nanoid": "^5.1.6",
    "next": "15.5.2",
    "next-themes": "^0.4.6",
    "pako": "^1.0.11",
    "postcss": "^8.5.6",
    "prettier": "^3.3.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.51.1",
    "react-i18next": "^15.1.2",
    "setimmediate": "^1.0.5",
    "shadcn": "^3.5.0",
    "shiki": "^3.15.0",
    "sonner": "^2.0.7",
    "streamdown": "^1.4.0",
    "streamsearch": "1.1.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "three": "^0.182.0",
    "tokenlens": "^1.3.1",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "use-stick-to-bottom": "^1.1.1",
    "vite": "5.4.21",
    "vitest": "^2.1.2",
    "wavesurfer.js": "^7.12.1",
    "web-vitals": "^4.2.4",
    "zustand": "^4.5.0"
  },
  "build": {
    "appId": "com.iartstudio.pc",
    "productName": "IARTStudio",
    "npmRebuild": false,
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "asar": true,
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**",
      "**/node_modules/koffi/**",
      "**/node_modules/@koromix/koffi-*/**",
      "**/node_modules/sharp/**",
      "**/node_modules/@img/sharp-*/**",
      "**/node_modules/@img/sharp-libvips-*/**",
      "**/apps/backend/native-modules/better-sqlite3/**"
    ],
    "publish": {
      "provider": "generic",
      "url": "https://github.com/tf961656585/IArt/releases/latest/download"
    },
    "files": [
      "apps/backend/dist/**/*",
      "apps/backend/native-modules/**/*",
      "apps/desktop-shell/dist/**/*",
      "apps/desktop-shell/resources/**/*",
      "apps/editor/dist-static/**/*",
      "apps/hub/dist-static/**/*",
      "packages/contracts/dist/**/*",
      "packages/domain/dist/**/*",
      "packages/utils/dist/**/*",
      ".env.example",
      "package.json",
      "!**/node_modules/.cache",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": ".model-assets/packages",
        "to": "model-assets",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "apps/backend/native-modules/better-sqlite3/electron/node_modules",
        "to": "app.asar.unpacked/apps/backend/native-modules/better-sqlite3/electron/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "buildResources": "apps/desktop-shell/resources",
      "output": "dist-desktop"
    },
    "mac": {
      "target": [
        "zip",
        "dmg"
      ],
      "identity": null,
      "icon": "apps/desktop-shell/resources/icons/icon.icns",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "background": "apps/desktop-shell/resources/dmg/dmg-background.png",
      "contents": [
        {
          "x": 220,
          "y": 380
        },
        {
          "x": 540,
          "y": 380,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 760,
        "height": 540
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "apps/desktop-shell/resources/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "apps/desktop-shell/resources/icons/icon-512.png",
      "maintainer": "IARTStudio",
      "artifactName": "${productName}-${version}-linux-x64.${ext}"
    }
  },
  "overrides": {
    "cookie": "0.7.2",
    "esbuild": "0.25.4",
    "path-to-regexp": "6.3.0",
    "undici": "7.16.0"
  },
  "pnpm": {
    "overrides": {
      "@radix-ui/react-presence": "1.1.4"
    },
    "onlyBuiltDependencies": [
      "@google/genai",
      "better-sqlite3",
      "electron",
      "esbuild",
      "ffmpeg-static",
      "koffi",
      "msw",
      "protobufjs",
      "sharp",
      "unrs-resolver"
    ],
    "patchedDependencies": {
      "@xyflow/react@12.10.0": "patches/@xyflow__react@12.10.0.patch"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tf961656585/IArt.git"
  },
  "description": "Asset-context canvas creation space for desktop."
}
