{
  "zones": [
    "apps/editor/src",
    "apps/hub/src",
    "packages/contracts/src/task-notification.ts",
    "packages/contracts/src/editor-storage-runtime-read-contract.ts"
  ],
  "boundaryZones": [
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ],
  "forbiddenNames": [
    "metadataJson",
    "requestJson",
    "payloadJson"
  ],
  "fileExtensions": [".ts", ".tsx", ".cts", ".mts"],
  "ignorePaths": [
    "node_modules/**",
    "**/*.d.ts",
    "**/*.d.cts",
    "**/*.d.mts",
    "**/dist/**",
    "**/build/**",
    "**/.next/**",
    "**/coverage/**",
    "dist-desktop/**"
  ]
}
