          "kind": "response",
          "path": "data[].outputs[].url"
        },
        "required": false,
        "default_value": null
      }
    ],
    "note": "Kling 新标准统一查询端点 GET /tasks?task_ids={id}；响应 data[] → outputs[] 取 url（spec 07 §9.2）"
