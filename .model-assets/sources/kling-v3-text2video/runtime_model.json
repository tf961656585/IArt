  },
  "polling_strategy": {
    "request": {
      "url_template": "/tasks?task_ids={id}",
      "method": "GET",
      "headers": {},
      "body": null
    },
    "polling": {
      "intervalMs": 3000,
      "maxAttempts": 500,
      "successFieldPaths": [
        "data.0.outputs.0.url",
        "data.0.status"
      ],
      "successStatuses": [
        "succeeded"
      ],
      "statusFieldPaths": [
        "data.0.status",
        "data.status",
        "status"
      ],
      "failureStatuses": [
        "failed",
        "failure",
        "error"
      ],
      "failureCodePaths": [],
