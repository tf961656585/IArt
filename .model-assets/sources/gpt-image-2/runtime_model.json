  "runtime": {
    "provider_id": "openai",
    "default_task_type": "image",
    "mode": "image",
    "aliases": [
      "gpt-image-2-edit"
    ],
    "payload_format_rule": {
      "kind": "when",
      "condition": {
        "op": "ne",
        "field": "image",
        "value": []
      },
      "truthy": {
        "kind": "literal",
        "value": "multipart"
      },
      "falsy": {
        "kind": "literal",
        "value": "json"
      }
    },
    "workspace": {
      "task_list_position": "bottom",
      "task_queue": {
        "enabled": true,
        "max_concurrent": 10
      }
    },
    "api_defaults": {
      "endpoint": "/v1/images/generations",
      "method": "POST",
      "contentType": "application/json"
    },
    "payload_rules": {
      "api.endpoint": {
        "kind": "when",
        "condition": {
          "op": "ne",
          "field": "image",
          "value": []
        },
        "truthy": {
          "kind": "literal",
          "value": "/v1/images/edits"
        },
        "falsy": {
          "kind": "literal",
          "value": "/v1/images/generations"
        }
      },
      "api.method": {
        "kind": "literal",
        "value": "POST"
      },
      "api.contentType": {
        "kind": "when",
        "condition": {
          "op": "ne",
          "field": "image",
          "value": []
        },
        "truthy": {
          "kind": "literal",
          "value": null
        },
        "falsy": {
          "kind": "literal",
          "value": "application/json"
        }
      },
      "api.headers.Accept": {
        "kind": "literal",
        "value": "application/json"
      },
      "body.model": {
        "kind": "literal",
        "value": "gpt-image-2"
      },
      "body.prompt": {
        "kind": "field",
        "field_key": "__prompt",
        "transforms": [
          "trim"
        ]
      },
      "body.image": {
        "kind": "when",
        "condition": {
          "op": "ne",
          "field": "image",
          "value": []
        },
        "truthy": {
          "kind": "compute",
          "operator": "assert_array_length",
          "args": [
            {
              "kind": "field",
              "field_key": "image",
              "transforms": [
                "allUploadFiles"
              ],
              "media_target": "multipart_file"
            }
          ],
          "cache_key": "gptImage2.image",
          "options": {
            "min_items": 1,
            "max_items": 16,
            "message": "请至少提供 1 张要编辑的图片。"
          }
        },
        "falsy": {
          "kind": "literal",
          "value": null
        }
      },
      "body.n": {
        "kind": "when",
        "condition": {
          "op": "ne",
          "field": "image",
          "value": []
        },
        "truthy": {
          "kind": "literal",
          "value": null
        },
        "falsy": {
          "kind": "literal",
          "value": 1
        }
      },
      "body.size": {
        "kind": "field",
        "field_key": "size"
      },
      "body.quality": {
        "kind": "field",
        "field_key": "quality"
      },
      "body.output_format": {
        "kind": "field",
        "field_key": "format"
      },
      "body.moderation": {
        "kind": "field",
        "field_key": "moderation"
      },
      "prompt": {
        "kind": "field",
        "field_key": "__prompt",
        "transforms": [
          "trim"
        ]
      },
      "input": {
        "kind": "field",
        "field_key": "__prompt",
        "transforms": [
          "trim"
        ]
      },
      "meta.size": {
        "kind": "field",
        "field_key": "size"
      },
      "meta.model_id": {
        "kind": "literal",
        "value": "gpt-image-2"
      }
    },
    "capabilities": {
      "execution_traits": [
        "nonBlocking"
      ]
    },
    "schema_defaults": {
      "image": [],
      "size": "auto",
      "quality": "auto",
      "format": "jpeg",
      "moderation": "auto"
    },
    "execution_driver": "http_formal_task"
  },
  "request_strategy": {
    "request_stage": "submit",
    "protocol": "http",
    "endpoint": "/v1/images/generations",
    "method": "POST",
    "header_rules": [],
    "body_rules": [],
    "query_rules": []
  },
  "result_rule": {
    "mode": "sync",
    "submit_response_id_path": "/id",
    "failure_condition": {
      "op": "any",
      "children": [
        {
          "op": "not_empty",
          "path": "error.message"
        },
        {
          "op": "not_empty",
          "path": "error.code"
        },
        {
          "op": "not_empty",
          "path": "error.type"
        }
      ]
    },
    "error_mapping_rules": [
      {
        "target": "code",
        "source": {
          "kind": "response",
          "path": "error.code"
        },
        "required": false
      },
      {
        "target": "message",
        "source": {
          "kind": "response",
          "path": "error.message"
        },
        "required": false
      },
      {
        "target": "details.remote.type",
        "source": {
          "kind": "response",
          "path": "error.type"
        },
        "required": false
      },
      {
        "target": "details.remote.param",
        "source": {
          "kind": "response",
          "path": "error.param"
        },
        "required": false
      }
    ]
  },
  "result_output_mapping": {
    "response_mode": "structured_payload",
    "output_mapping_rules": [
      {
        "target": "output.image_url",
        "source": {
          "kind": "response",
          "path": "data"
        },
        "required": true
      }
    ],
    "note": "gpt-image-2 structured response mapping"
  },
  "prompt_field": {
    "field_key": "__prompt",
    "required": true,
    "validation_rules": []
  }
