    "payload_rules": {
      "api.endpoint": {
        "kind": "literal",
        "value": "/v1beta/models/{model}:predictLongRunning"
      },
      "api.method": {
        "kind": "literal",
        "value": "POST"
      },
      "body.instances": {
        "kind": "compute",
        "operator": "array",
        "cache_key": "veo31Standard.instances",
        "args": [
          {
            "kind": "compute",
            "operator": "compact_object",
            "cache_key": "veo31Standard.instance",
            "entries": {
              "prompt": {
                "kind": "when",
                "condition": {
                  "op": "truthy",
                  "field": "__prompt"
                },
                "truthy": {
                  "kind": "field",
                  "field_key": "__prompt",
                  "transforms": [
                    "trim"
                  ]
                }
              },
              "image": {
                "kind": "when",
                "condition": {
                  "op": "ne",
                  "field": "firstFrameImage",
                  "value": []
                },
                "truthy": {
                  "kind": "field",
                  "field_key": "firstFrameImage",
                  "transforms": [
                    "extractFirstUrl"
                  ],
                  "media_target": "inline_data"
                }
              },
              "lastFrame": {
                "kind": "when",
                "condition": {
                  "op": "ne",
                  "field": "lastFrameImage",
                  "value": []
                },
                "truthy": {
                  "kind": "field",
                  "field_key": "lastFrameImage",
                  "transforms": [
                    "extractFirstUrl"
                  ],
                  "media_target": "inline_data"
                }
              },
              "referenceImages": {
                "kind": "when",
                "condition": {
                  "op": "ne",
                  "field": "referenceImages",
                  "value": []
                },
                "truthy": {
                  "kind": "compute",
                  "operator": "map_array",
                  "cache_key": "veo31Standard.referenceImages",
                  "media_target": "inline_data",
                  "options": {
                    "source": {
                      "kind": "field",
                      "field_key": "referenceImages",
                      "transforms": [
                        "extractUrls"
                      ],
                      "media_target": "inline_data"
                    },
                    "item": {
                      "kind": "compute",
                      "operator": "object",
                      "entries": {
                        "image": {
                          "kind": "item"
                        },
                        "referenceType": {
                          "kind": "literal",
                          "value": "asset"
                        }
                      }
                    },
                    "max_items": 3,
                    "skip_if_empty": true
                  }
                }
              }
            }
          }
        ]
      },
      "body.parameters": {
        "kind": "compute",
        "operator": "compact_object",
        "cache_key": "veo31Standard.parameters",
        "entries": {
          "aspectRatio": {
            "kind": "compute",
            "operator": "normalize_enum",
            "cache_key": "veo31Standard.aspectRatio",
            "args": [
              {
                "kind": "field",
                "field_key": "aspectRatio",
                "transforms": [
                  "trim"
                ]
              }
            ],
            "options": {
              "allowed_values": [
                "16:9",
                "9:16"
              ],
              "fallback": "16:9"
            }
          },
          "durationSeconds": {
            "kind": "compute",
            "operator": "normalize_enum",
            "cache_key": "veo31Standard.durationSeconds",
            "args": [
              {
                "kind": "field",
                "field_key": "durationSeconds",
                "transforms": [
                  "trim"
                ]
              }
            ],
            "options": {
              "allowed_values": [
                "4",
                "6",
                "8"
              ],
              "fallback": "8"
            }
          },
          "resolution": {
            "kind": "compute",
            "operator": "normalize_enum",
            "cache_key": "veo31Standard.resolution",
            "args": [
              {
                "kind": "field",
                "field_key": "resolution",
                "transforms": [
                  "trim"
                ]
              }
            ],
            "options": {
              "allowed_values": [
                "720p",
                "1080p",
                "4k"
              ],
              "fallback": "720p"
            }
          },
          "personGeneration": {
            "kind": "when",
            "condition": {
              "op": "or",
              "conditions": [
                {
                  "op": "ne",
                  "field": "firstFrameImage",
                  "value": []
                },
                {
                  "op": "ne",
                  "field": "referenceImages",
                  "value": []
                }
              ]
            },
            "truthy": {
              "kind": "literal",
              "value": "allow_adult"
            },
            "falsy": {
              "kind": "literal",
              "value": "allow_all"
            }
          },
          "seed": {
            "kind": "when",
            "condition": {
              "op": "truthy",
              "field": "seed"
            },
            "truthy": {
              "kind": "field",
              "field_key": "seed",
              "transforms": [
                "toNumber"
              ]
            }
          }
        }
      },
      "prompt": {
        "kind": "field",
        "field_key": "__prompt",
        "transforms": [
          "trim"
        ]
      },
      "input": {
        "kind": "field",
        "field_key": "__prompt",
        "transforms": [
          "trim"
        ]
      },
      "meta.model_id": {
        "kind": "literal",
        "value": "veo-3.1-generate-preview"
      },
      "meta.aspectRatio": {
        "kind": "field",
        "field_key": "aspectRatio"
      },
      "meta.durationSeconds": {
        "kind": "field",
        "field_key": "durationSeconds"
      },
      "meta.resolution": {
        "kind": "field",
        "field_key": "resolution"
      }
    },
    "execution_driver": "http_formal_task"
  },
  "request_strategy": {
    "request_stage": "submit",
    "protocol": "http",
    "endpoint": "/v1beta/models/{model}:predictLongRunning",
