            "value": ":generateContent"
          }
        ]
      },
      "api.method": {
        "kind": "literal",
        "value": "POST"
      },
      "body.contents": {
        "kind": "compute",
        "operator": "build_content_blocks",
        "cache_key": "geminiTts.contents",
        "options": {
          "role": "user",
          "parts": [
