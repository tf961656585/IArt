              "part_kind": "text",
              "value": {
                "kind": "field",
                "field_key": "text",
                "transforms": [
                  "trim"
                ]
              },
              "skip_if_empty": true
            }
          ]
        },
        "media_target": "inline_data"
      },
      "body.generationConfig.responseModalities": {
        "kind": "literal",
        "value": [
          "AUDIO"
        ]
      },
      "body.generationConfig.speechConfig": {
        "kind": "when",
        "condition": {
          "op": "eq",
          "field": "mode",
          "value": "multi"
        },
        "truthy": {
          "kind": "compute",
          "operator": "object",
          "cache_key": "geminiTts.multiSpeechConfig",
          "entries": {
            "multiSpeakerVoiceConfig": {
              "kind": "compute",
              "operator": "object",
              "entries": {
                "speakerVoiceConfigs": {
                  "kind": "compute",
                  "operator": "map_array",
                  "options": {
                    "source": {
                      "kind": "compute",
                      "operator": "parse_line_pairs",
                      "args": [
                        {
                          "kind": "field",
                          "field_key": "speakerVoiceLines"
                        }
                      ],
                      "options": {
                        "left_key": "speaker",
                        "right_key": "voiceName",
                        "pair_delimiter": "|",
                        "message": "多人配音至少需要添加 1 个角色。"
                      }
                    },
                    "item": {
                      "kind": "compute",
                      "operator": "object",
                      "entries": {
                        "speaker": {
                          "kind": "item",
                          "path": "speaker"
                        },
                        "voiceConfig": {
                          "kind": "compute",
                          "operator": "object",
                          "entries": {
                            "prebuiltVoiceConfig": {
                              "kind": "compute",
                              "operator": "object",
                              "entries": {
                                "voiceName": {
                                  "kind": "item",
                                  "path": "voiceName"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "falsy": {
          "kind": "compute",
          "operator": "object",
          "cache_key": "geminiTts.singleSpeechConfig",
          "entries": {
            "voiceConfig": {
              "kind": "compute",
              "operator": "object",
              "entries": {
                "prebuiltVoiceConfig": {
                  "kind": "compute",
                  "operator": "object",
                  "entries": {
                    "voiceName": {
                      "kind": "compute",
                      "operator": "assert_non_empty",
                      "args": [
                        {
                          "kind": "field",
                          "field_key": "voiceName",
                          "transforms": [
                            "trim"
                          ]
                        }
                      ],
                      "options": {
                        "message": "单人配音需要填写声音名。"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
