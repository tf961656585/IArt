        "4_5": {
          "label": "4:5"
        },
        "5_4": {
          "label": "5:4"
        },
        "9_16": {
          "label": "9:16"
        },
        "16_9": {
          "label": "16:9"
        },
        "21_9": {
          "label": "21:9"
