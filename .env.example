# IARTStudio (PC 桌面版) 环境变量示例
#
# 说明：
# - 本项目仅以 Electron 桌面形态运行（Hub 进程 + Editor 窗口）。
# - 所有网络请求与文件/媒体处理都应走本地 Hub 后端（backend/local-server）。
# - 这里仅保留桌面后端/调试相关的可选配置。

# 后端监听端口（默认 0 表示随机可用端口）
IART_BACKEND_PORT=0

# 后端数据存储根目录（默认：%LOCALAPPDATA%\\IARTStudio_PC）
# IART_STORAGE_PATH=C:\\Users\\<you>\\AppData\\Local\\IARTStudio_PC

# 媒体文件目录（默认：${IART_STORAGE_PATH}\\media）
# IART_MEDIA_PATH=C:\\Users\\<you>\\AppData\\Local\\IARTStudio_PC\\media

# 日志等级：debug/info/warn/error（默认 info）
IART_LOG_LEVEL=info

# （仅开发期）指定 Editor 渲染地址：不设置时将自动使用本地 Hub 提供的 editor 静态资源，
# 或回退到 http://localhost:3000
# IART_EDITOR_URL=http://localhost:3000

# 公共中转端点（用户自带）：产品不内置默认端点。需要中转的模型（如官方包声明
# public_relay 上传模式的模型）在未配置时不可用。也可在 Hub「设置 → 公共中转」配置
# （设置页与 backend.json 优先级低于此环境变量）。
IART_PUBLIC_UPLOAD_CLOUDFLARE_IMAGE_PUBLIC_URL_ENDPOINT=

# 图像中转端点（用户自带）：仅服务图像类型；留空表示未配置。
IART_PUBLIC_UPLOAD_SELF_HOSTED_IMAGE_PUBLIC_URL_ENDPOINT=
