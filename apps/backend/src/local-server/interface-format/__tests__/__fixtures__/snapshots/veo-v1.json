{
  "runtimeModel": {
    "model_id": "interface-format-golden-model",
    "provider_id": "google",
    "default_task_type": "video",
    "mode": "video",
    "role": "generator",
    "capability": {
      "input_modalities": [
        "text",
        "image"
      ],
      "output_modalities": [
        "video"
      ],
      "supports_async_task": true,
      "supports_streaming": false,
      "supports_multi_image": false,
      "supports_reference_media": true,
      "constraints": []
    },
    "parameter_schema": {
      "schema_type": "object",
      "fields": [
        {
          "label": "fields.firstFrameImage.label",
          "description": "fields.firstFrameImage.description",
          "required": false,
          "validation_rules": [],
          "layout": {
            "colSpan": 1
          },
          "component_props": {
            "accept": "image/*",
            "maxFiles": 1
          },
          "field_key": "firstFrameImage",
          "component": "imageUpload",
          "default_value": []
        },
        {
          "label": "fields.lastFrameImage.label",
          "description": "fields.lastFrameImage.description",
          "required": false,
          "validation_rules": [],
          "layout": {
            "colSpan": 1
          },
          "component_props": {
            "accept": "image/*",
            "maxFiles": 1
          },
          "field_key": "lastFrameImage",
          "component": "imageUpload",
          "default_value": []
        },
        {
          "field_key": "aspectRatio",
          "label": "fields.aspectRatio.label",
          "description": "fields.aspectRatio.description",
          "required": false,
          "validation_rules": [],
          "layout": {
            "colSpan": 1
          },
          "component": "select",
          "enum_options": [
            {
              "value": "16:9",
              "label": "fields.aspectRatio.options.ratio_16_9.label"
            },
            {
              "value": "9:16",
              "label": "fields.aspectRatio.options.ratio_9_16.label"
            }
          ],
          "component_props": {},
          "default_value": "16:9"
        },
        {
          "field_key": "durationSeconds",
          "label": "fields.durationSeconds.label",
          "description": "fields.durationSeconds.description",
          "required": false,
          "validation_rules": [],
          "layout": {
            "colSpan": 1
          },
          "component": "select",
          "enum_options": [
            {
              "value": "4",
              "label": "fields.durationSeconds.options.duration_4.label"
            },
            {
              "value": "6",
              "label": "fields.durationSeconds.options.duration_6.label"
            },
            {
              "value": "8",
              "label": "fields.durationSeconds.options.duration_8.label"
            }
          ],
          "component_props": {},
          "default_value": "8"
        },
        {
          "field_key": "resolution",
          "label": "fields.resolution.label",
          "description": "fields.resolution.description",
          "required": false,
          "validation_rules": [],
          "layout": {
            "colSpan": 1
          },
          "component": "select",
          "enum_options": [
            {
              "value": "720p",
              "label": "fields.resolution.options.resolution_720p.label"
            },
            {
              "value": "1080p",
              "label": "fields.resolution.options.resolution_1080p.label"
            }
          ],
          "component_props": {},
          "default_value": "720p"
        },
        {
          "field_key": "seed",
          "label": "fields.seed.label",
          "description": "fields.seed.description",
          "required": false,
          "validation_rules": [],
          "layout": {
            "colSpan": 1
          },
          "component": "number",
          "component_props": {}
        }
      ],
      "required_fields": [],
      "validation_rules": [],
      "default_values": {
        "aspectRatio": "16:9",
        "durationSeconds": "8",
        "resolution": "720p",
        "firstFrameImage": [],
        "lastFrameImage": []
      }
    },
    "execution_profile": {
      "task_type": "video",
      "supports_async_task": true
    },
    "display": {
      "visible": true,
      "order": 9000
    },
    "runtime": {
      "provider_id": "google",
      "default_task_type": "video",
      "mode": "video",
      "aliases": [],
      "workspace": {
        "task_list_position": "right"
      },
      "api_defaults": {
        "endpoint": "/v1beta/models/{model}:predictLongRunning",
        "method": "POST",
        "contentType": "application/json"
      },
      "payload_rules": {
        "api.endpoint": {
          "kind": "literal",
          "value": "/v1beta/models/{model}:predictLongRunning"
        },
        "api.method": {
          "kind": "literal",
          "value": "POST"
        },
        "api.contentType": {
          "kind": "literal",
          "value": "application/json"
        },
        "body.instances": {
          "kind": "compute",
          "operator": "array",
          "cache_key": "declaredVeoV1.instances",
          "note": "按记录的素材位组装官方 instances：prompt 与首帧/尾帧/参考图分支，compact_object 丢弃未填写的分支。",
          "args": [
            {
              "kind": "compute",
              "operator": "compact_object",
              "cache_key": "declaredVeoV1.instance",
              "entries": {
                "prompt": {
                  "kind": "when",
                  "condition": {
                    "op": "truthy",
                    "field": "__prompt"
                  },
                  "truthy": {
                    "kind": "field",
                    "field_key": "__prompt",
                    "transforms": [
                      "trim"
                    ]
                  }
                },
                "image": {
                  "kind": "when",
                  "condition": {
                    "op": "ne",
                    "field": "firstFrameImage",
                    "value": []
                  },
                  "truthy": {
                    "kind": "field",
                    "field_key": "firstFrameImage",
                    "transforms": [
                      "extractFirstUrl"
                    ],
                    "media_target": "inline_data"
                  }
                },
                "lastFrame": {
                  "kind": "when",
                  "condition": {
                    "op": "ne",
                    "field": "lastFrameImage",
                    "value": []
                  },
                  "truthy": {
                    "kind": "field",
                    "field_key": "lastFrameImage",
                    "transforms": [
                      "extractFirstUrl"
                    ],
                    "media_target": "inline_data"
                  }
                }
              }
            }
          ]
        },
        "body.parameters": {
          "kind": "compute",
          "operator": "compact_object",
          "cache_key": "declaredVeoV1.parameters",
          "entries": {
            "aspectRatio": {
              "kind": "compute",
              "operator": "normalize_enum",
              "cache_key": "declaredVeoV1.aspectRatio",
              "args": [
                {
                  "kind": "field",
                  "field_key": "aspectRatio",
                  "transforms": [
                    "trim"
                  ]
                }
              ],
              "options": {
                "allowed_values": [
                  "16:9",
                  "9:16"
                ],
                "fallback": "16:9"
              }
            },
            "durationSeconds": {
              "kind": "compute",
              "operator": "normalize_enum",
              "cache_key": "declaredVeoV1.durationSeconds",
              "args": [
                {
                  "kind": "field",
                  "field_key": "durationSeconds",
                  "transforms": [
                    "trim"
                  ]
                }
              ],
              "options": {
                "allowed_values": [
                  "4",
                  "6",
                  "8"
                ],
                "fallback": "8"
              }
            },
            "resolution": {
              "kind": "compute",
              "operator": "normalize_enum",
              "cache_key": "declaredVeoV1.resolution",
              "args": [
                {
                  "kind": "field",
                  "field_key": "resolution",
                  "transforms": [
                    "trim"
                  ]
                }
              ],
              "options": {
                "allowed_values": [
                  "720p",
                  "1080p"
                ],
                "fallback": "720p"
              }
            },
            "personGeneration": {
              "kind": "when",
              "condition": {
                "op": "ne",
                "field": "firstFrameImage",
                "value": []
              },
              "truthy": {
                "kind": "literal",
                "value": "allow_adult"
              },
              "falsy": {
                "kind": "literal",
                "value": "allow_all"
              }
            },
            "seed": {
              "kind": "when",
              "condition": {
                "op": "truthy",
                "field": "seed"
              },
              "truthy": {
                "kind": "field",
                "field_key": "seed",
                "transforms": [
                  "toNumber"
                ]
              }
            }
          }
        },
        "prompt": {
          "kind": "field",
          "field_key": "__prompt",
          "transforms": [
            "trim"
          ]
        },
        "input": {
          "kind": "field",
          "field_key": "__prompt",
          "transforms": [
            "trim"
          ]
        },
        "meta.model_id": {
          "kind": "literal",
          "value": "interface-format-golden-model"
        },
        "meta.aspectRatio": {
          "kind": "field",
          "field_key": "aspectRatio"
        },
        "meta.durationSeconds": {
          "kind": "field",
          "field_key": "durationSeconds"
        },
        "meta.resolution": {
          "kind": "field",
          "field_key": "resolution"
        }
      },
      "capabilities": {
        "execution_traits": [
          "nonBlocking"
        ]
      },
      "schema_defaults": {
        "aspectRatio": "16:9",
        "durationSeconds": "8",
        "resolution": "720p",
        "firstFrameImage": [],
        "lastFrameImage": []
      },
      "execution_driver": "http_formal_task",
      "form_field_style": "dotted",
      "form_array_style": "repeat",
      "payload_format": "json"
    },
    "request_strategy": {
      "request_stage": "submit",
      "protocol": "http",
      "endpoint": "/v1beta/models/{model}:predictLongRunning",
      "method": "POST"
    },
    "prompt_field": {
      "field_key": "__prompt",
      "required": true,
      "validation_rules": []
    },
    "result_rule": {
      "mode": "async",
      "submit_response_id_path": "/name"
    },
    "result_output_mapping": {
      "response_mode": "structured_payload",
      "output_mapping_rules": [
        {
          "target": "output.video_url",
          "source": {
            "kind": "response",
            "path": "response.generateVideoResponse.generatedSamples[0].video.uri"
          },
          "required": false,
          "default_value": null
        }
      ],
      "note": "declared generation model (veo-v1 family template)"
    },
    "polling_strategy": {
      "request": {
        "url_template": "/v1beta/{operation_name}",
        "method": "GET",
        "headers": {},
        "query": [],
        "body": null,
        "body_format": "json",
        "content_type": null
      },
      "polling": {
        "intervalMs": 10000,
        "maxAttempts": 120,
        "successStatuses": [
          "true"
        ],
        "statusFieldPaths": [
          "done"
        ],
        "failureStatuses": [
          "error",
          "failed",
          "failure",
          "cancelled",
          "canceled"
        ],
        "successFieldPaths": [
          "response.generateVideoResponse.generatedSamples[0].video.uri"
        ],
        "failureCodePaths": [
          "error.code"
        ],
        "failureMessagePaths": [
          "error.message",
          "error.status",
          "error.details"
        ]
      }
    }
  },
  "node": {
    "node_type": "model",
    "group_key": "google",
    "input_ports": [
      {
        "id": "firstFrameImage",
        "name": "ports.inputs.firstFrameImage.name",
        "data_type": "image",
        "required": false,
        "max_connections": 1,
        "description": "ports.inputs.firstFrameImage.description",
        "field_key": "firstFrameImage",
        "multiple": false
      },
      {
        "id": "lastFrameImage",
        "name": "ports.inputs.lastFrameImage.name",
        "data_type": "image",
        "required": false,
        "max_connections": 1,
        "description": "ports.inputs.lastFrameImage.description",
        "field_key": "lastFrameImage",
        "multiple": false
      }
    ],
    "output_ports": [
      {
        "id": "video",
        "name": "ports.outputs.video.name",
        "data_type": "video",
        "field_key": "output_video",
        "multiple": true,
        "description": "ports.outputs.video.description"
      }
    ]
  },
