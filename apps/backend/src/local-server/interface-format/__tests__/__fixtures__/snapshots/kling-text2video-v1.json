        "duration": 5,
        "resolution": "720p",
        "aspectRatio": "16:9",
        "audio": "off",
        "multiShot": true,
        "watermark": false
      },
      "execution_driver": "http_formal_task",
      "form_field_style": "dotted",
      "form_array_style": "repeat",
      "payload_format": "json"
    },
    "request_strategy": {
      "request_stage": "submit",
      "protocol": "http",
      "endpoint": "/text-to-video/kling-3.0",
      "method": "POST"
    },
    "prompt_field": {
      "field_key": "__prompt",
      "required": true,
      "validation_rules": []
    },
    "result_rule": {
      "mode": "async",
      "submit_response_id_path": "/data/id"
    },
    "result_output_mapping": {
      "response_mode": "structured_payload",
      "output_mapping_rules": [
        {
          "target": "output.video_url",
          "source": {
            "kind": "response",
            "path": "data[].outputs[].url"
          },
          "required": false,
          "default_value": null
        }
      ],
      "note": "可灵新标准统一查询端点 GET /tasks?task_ids={id}；响应 data[] → outputs[] 取 url（spec 07 §9.2）"
    },
    "polling_strategy": {
      "request": {
        "url_template": "/tasks?task_ids={id}",
        "method": "GET",
        "headers": {},
        "query": [],
        "body": null,
        "body_format": "json",
        "content_type": null
      },
      "polling": {
        "intervalMs": 3000,
        "maxAttempts": 500,
        "successStatuses": [
          "succeeded"
        ],
        "statusFieldPaths": [
          "data.0.status",
          "data.status",
          "status"
        ],
        "failureStatuses": [
          "failed",
          "failure",
          "error"
        ],
        "successFieldPaths": [
          "data.0.outputs.0.url",
          "data.0.status"
        ],
        "failureCodePaths": [],
        "failureMessagePaths": [
          "data.0.message",
          "data.message",
          "message"
        ]
      }
    }
  },
  "node": {
