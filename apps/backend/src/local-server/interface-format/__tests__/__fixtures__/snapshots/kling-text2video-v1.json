              "off"
            ],
            "fallback": "off"
          }
        },
        "meta.aspectRatio": {
          "kind": "compute",
          "operator": "normalize_enum",
          "cache_key": "klingV3Text2Video.aspectRatio",
          "args": [
            {
              "kind": "field",
              "field_key": "aspectRatio",
