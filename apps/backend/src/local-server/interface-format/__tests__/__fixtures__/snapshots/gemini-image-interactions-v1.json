            "op": "not_empty",
            "path": "error.message"
          },
          {
            "op": "not_empty",
            "path": "error.code"
          },
          {
            "op": "not_empty",
            "path": "error.status"
          }
        ]
      },
      "error_mapping_rules": [
        {
          "target": "code",
          "source": {
            "kind": "response",
            "path": "error.code"
          },
          "required": false
        },
        {
          "target": "message",
          "source": {
            "kind": "response",
            "path": "error.message"
          },
          "required": false
        },
        {
          "target": "details.remote.status",
          "source": {
            "kind": "response",
            "path": "error.status"
          },
          "required": false
        }
      ],
      "submit_response_id_path": "/id"
    },
