                "args": [
                  {
                    "kind": "field",
                    "field_key": "imageSize",
                    "transforms": [
                      "trim"
                    ]
                  }
                ],
                "options": {
                  "allowed_values": [
                    "1K",
                    "2K",
                    "4K"
                  ],
                  "fallback": "1K"
                }
              }
            },
            "mime_type": {
              "kind": "when",
              "condition": {
                "op": "truthy",
                "field": "mimeType"
              },
              "truthy": {
                "kind": "field",
                "field_key": "mimeType",
                "transforms": [
                  "trim"
                ]
              }
            }
