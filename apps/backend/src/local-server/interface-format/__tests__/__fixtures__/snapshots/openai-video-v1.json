          },
          "required": true
        }
      ],
      "note": "openai-video-v1 family template: binary final result is materialized by the acquisition stage"
    },
    "result_acquisition_strategy": {
      "acquisition_mode": "fetch_final_result",
      "identity_source": "remote_request_id",
