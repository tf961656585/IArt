        "request_stage": "acquisition",
        "protocol": "http",
        "endpoint": "/v1/videos/{id}/content",
        "method": "GET"
      },
      "accept": "binary",
      "media_type": "video",
      "requires_auth": true,
      "note": "openai-video-v1 family template: GET /v1/videos/{id}/content (binary, same-origin credential)",
      "request_headers": {}
    },
    "polling_strategy": {
      "request": {
        "url_template": "/v1/videos/{id}",
        "method": "GET",
        "headers": {},
        "query": [],
        "body": null,
        "body_format": "json",
        "content_type": null
      },
      "polling": {
        "intervalMs": 10000,
        "maxAttempts": 500,
        "successStatuses": [
          "completed",
          "succeeded",
          "success",
          "done"
        ],
        "statusFieldPaths": [
          "status",
          "data.status",
          "state"
        ],
        "failureStatuses": [
          "failed",
          "error",
          "cancelled",
          "canceled"
        ],
        "failureCodePaths": [
          "error.code",
          "data.error.code"
        ],
        "failureMessagePaths": [
          "error.message",
          "message",
          "data.error.message"
        ]
      }
    }
