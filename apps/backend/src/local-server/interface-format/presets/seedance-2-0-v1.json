          "description": "ports.inputs.last_frame.description"
        }
      },
      "reference_image": {
        "schema_field": {
          "label": "fields.reference_images.label",
          "description": "fields.reference_images.description",
          "required": false,
          "default_value": [],
          "validation_rules": [],
          "layout": { "colSpan": 1 },
          "component_props": {
            "accept": "image/*",
