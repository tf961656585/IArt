          "component_props": {
            "min": 0,
            "max": 100,
            "step": 1
          },
          "visible_when": {
            "field": "format",
            "op": "in",
            "value": ["jpeg", "webp"]
          }
        },
        {
          "field_key": "complexity",
          "label": "fields.complexity.label",
