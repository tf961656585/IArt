            },
            {
              "value": "svg",
              "label": "fields.format.options.svg.label",
              "opt_in": true
            }
          ],
          "component_props": {}
        },
        {
          "field_key": "background",
          "label": "fields.background.label",
          "description": "fields.background.description",
          "required": false,
          "validation_rules": [],
          "layout": {
            "colSpan": 1
          },
          "component": "select",
          "enum_options": [
            {
              "value": "auto",
              "label": "fields.background.options.auto.label"
            },
            {
              "value": "opaque",
