              },
              {
                "value": "2560x1440"
              },
              {
                "value": "3840x2160"
              }
            ],
            "constraints": {
              "dimensionMultiple": 16,
              "maxLongEdge": 3840,
              "minPixels": 655360,
              "maxPixels": 8294400,
              "maxAspectRatio": 3
            }
          }
        },
        {
