  },
  "media": {
    "supports": ["reference_image"],
    "required": [],
    "slots": {
      "reference_image": {
        "field_key": "image",
        "component": "imageUpload",
        "wire_name": "image",
        "max_files": 16
      }
    }
  },
  "projection": {
    "provider_id": "openai",
    "group_key": "openai",
    "capability": {
      "input_modalities": {
        "$if": { "$slot_present": "reference_image" },
        "then": ["text", "image"],
        "else": ["text"]
      },
      "output_modalities": ["image"],
      "supports_async_task": false,
      "supports_streaming": false,
      "supports_multi_image": {
        "$if": { "$slot_present": "reference_image" },
        "then": true,
        "else": false
      },
      "supports_reference_media": {
        "$if": { "$slot_present": "reference_image" },
        "then": true,
        "else": false
      },
      "constraints": []
    },
    "execution_profile": {
      "task_type": "image",
      "supports_async_task": false
    },
    "display": {
      "visible": true,
      "order": 9000
    },
    "workspace": {
      "task_list_position": "bottom",
      "task_queue": {
        "enabled": true,
        "max_concurrent": 10
      }
    },
    "execution_driver": "http_formal_task",
    "runtime_extras": {
      "payload_format_rule": {
        "$if": { "$slot_present": "reference_image" },
        "then": {
          "kind": "when",
          "condition": { "op": "ne", "field": "image", "value": [] },
          "truthy": { "kind": "literal", "value": "multipart" },
          "falsy": { "kind": "literal", "value": "json" }
        }
      }
    },
    "node": {
      "node_type": "model",
      "output_ports": [
        {
          "id": "image",
          "name": "ports.outputs.image.name",
          "data_type": "image",
          "field_key": "output_image",
          "multiple": true
        }
      ]
    }
  },
  "builtin_behavior": {
    "result_rule": {
      "mode": "sync",
      "failure_condition": {
        "op": "any",
        "children": [
          {
            "op": "not_empty",
            "path": "error.message"
          },
          {
            "op": "not_empty",
            "path": "error.code"
          },
          {
            "op": "not_empty",
            "path": "error.type"
          }
        ]
      },
      "error_mapping_rules": [
        {
          "target": "code",
          "source": {
            "kind": "response",
            "path": "error.code"
          },
          "required": false
        },
        {
          "target": "message",
          "source": {
            "kind": "response",
            "path": "error.message"
          },
          "required": false
        },
        {
          "target": "details.remote.type",
          "source": {
            "kind": "response",
            "path": "error.type"
          },
          "required": false
        },
        {
          "target": "details.remote.param",
          "source": {
            "kind": "response",
            "path": "error.param"
          },
          "required": false
        }
      ]
    },
    "result_output_mapping": {
      "response_mode": "structured_payload",
      "output_mapping_rules": [
        {
          "target": "output.image_url",
          "source": {
            "kind": "response",
            "path": "data"
          },
          "required": true
        }
      ],
      "note": "declared generation model (openai-image-v1 family template)"
    }
  },
  "composition": {
    "fragments": {
      "reference_image": {
        "schema_field": {
          "label": "fields.image.label",
          "description": "fields.image.description",
          "required": false,
          "default_value": [],
          "validation_rules": [],
          "layout": {
            "colSpan": 1
          },
          "component_props": {
            "accept": "image/*"
          },
          "data_source": "both"
        },
        "input_port": {
          "id": "image",
          "name": "ports.inputs.image.name",
          "data_type": "image",
          "required": false,
          "description": "ports.inputs.image.description"
        }
      }
    },
    "variants": []
  },
