{
  "schema_version": 1,
  "format_id": "openai-image-v1",
  "version": "1.0.0",
  "display_name": "OpenAI Image",
  "family": "generation",
  "origin": "preset",
  "status": "ready",
  "order": 10,
  "transport": {
    "auth": {
      "kind": "bearer",
      "header_name": "Authorization",
      "prefix": "Bearer"
    },
    "endpoints": {
      "generations": "/v1/images/generations",
      "edits": "/v1/images/edits"
    },
    "submit": {
      "endpoint_key": "generations",
      "method": "POST",
      "content_type": "application/json",
      "payload_format": "json",
      "response_id_path": "/id"
    },
    "payload_rules": {
      "api.endpoint": {
        "$if": { "$slot_present": "reference_image" },
        "then": {
          "kind": "when",
          "condition": { "op": "ne", "field": "image", "value": [] },
          "truthy": { "kind": "literal", "value": "{{endpoint:edits}}" },
          "falsy": { "kind": "literal", "value": "{{endpoint:generations}}" }
        },
        "else": { "kind": "literal", "value": "{{endpoint:generations}}" }
      },
      "api.method": { "kind": "literal", "value": "{{method:submit}}" },
      "api.contentType": {
        "$if": { "$slot_present": "reference_image" },
        "then": {
          "kind": "when",
          "condition": { "op": "ne", "field": "image", "value": [] },
          "truthy": { "kind": "literal", "value": null },
          "falsy": { "kind": "literal", "value": "{{content_type:submit}}" }
        },
        "else": { "kind": "literal", "value": "{{content_type:submit}}" }
      },
      "api.headers.Accept": { "kind": "literal", "value": "application/json" },
      "body.model": { "kind": "literal", "value": "{{model_id}}" },
      "body.prompt": { "kind": "field", "field_key": "__prompt", "transforms": ["trim"] },
      "body.image": {
        "$if": { "$slot_present": "reference_image" },
        "then": {
          "kind": "when",
          "condition": { "op": "ne", "field": "image", "value": [] },
          "truthy": {
            "kind": "compute",
            "operator": "assert_array_length",
            "args": [
              {
                "kind": "field",
                "field_key": "image",
                "transforms": ["allUploadFiles"],
                "media_target": "multipart_file"
              }
            ],
            "cache_key": "declaredGeneration.image",
            "options": {
              "min_items": 1,
              "max_items": 16,
              "message": "请至少提供 1 张要编辑的图片。"
            }
          },
          "falsy": { "kind": "literal", "value": null }
        }
      },
      "body.n": {
        "$if": { "$slot_present": "reference_image" },
        "then": {
          "kind": "when",
          "condition": { "op": "ne", "field": "image", "value": [] },
          "truthy": { "kind": "literal", "value": null },
          "falsy": { "kind": "literal", "value": 1 }
        },
        "else": { "kind": "literal", "value": 1 }
      },
      "body.size": { "kind": "field", "field_key": "size" },
      "body.quality": { "kind": "field", "field_key": "quality" },
      "body.output_format": { "kind": "field", "field_key": "format" },
      "body.background": { "kind": "field", "field_key": "background" },
      "body.output_compression": { "kind": "field", "field_key": "output_compression" },
      "body.complexity": { "kind": "field", "field_key": "complexity" },
      "body.frame_count": { "kind": "field", "field_key": "frame_count" },
      "body.frame_duration_ms": { "kind": "field", "field_key": "frame_duration_ms" },
      "body.input_fidelity": { "kind": "field", "field_key": "input_fidelity" },
      "body.moderation": { "kind": "field", "field_key": "moderation" },
      "prompt": { "kind": "field", "field_key": "__prompt", "transforms": ["trim"] },
      "input": { "kind": "field", "field_key": "__prompt", "transforms": ["trim"] },
      "meta.size": { "kind": "field", "field_key": "size" },
      "meta.model_id": { "kind": "literal", "value": "{{model_id}}" }
    }
  },
  "parameters": {
    "schema": {
      "schema_type": "object",
      "fields": [
        {
          "field_key": "size",
