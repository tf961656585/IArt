          "lastFrame": { "name": "尾帧", "description": "接入素材或资产节点作为视频结束画面。" },
          "referenceImage": { "name": "参考图", "description": "接入素材或资产节点作为画面参考；可连几个取决于模型的最多张数。" }
        },
        "outputs": {
