{
  "schema_version": 1,
  "format_id": "openai-video-v1",
  "version": "1.0.0",
  "display_name": "OpenAI 视频",
  "family": "generation",
  "origin": "preset",
  "status": "ready",
  "order": 20,
  "transport": {
    "auth": {
      "kind": "bearer",
      "header_name": "Authorization",
      "prefix": "Bearer"
    },
    "endpoints": {
      "videos": "/v1/videos",
      "videoById": "/v1/videos/{id}",
      "videoContent": "/v1/videos/{id}/content"
    },
    "submit": {
      "endpoint_key": "videos",
      "method": "POST",
      "content_type": null,
      "payload_format": "multipart",
      "response_id_path": "id"
    },
    "async": {
      "identity_path": "id",
      "polling": {
        "endpoint_key": "videoById",
        "method": "GET",
        "interval_ms": 10000,
        "max_attempts": 500
      }
    },
    "payload_rules": {
      "api.endpoint": { "kind": "literal", "value": "{{endpoint:videos}}" },
      "api.method": { "kind": "literal", "value": "{{method:submit}}" },
      "api.contentType": { "kind": "literal", "value": null },
      "body.model": { "kind": "literal", "value": "{{model_id}}" },
      "body.prompt": { "kind": "field", "field_key": "__prompt", "transforms": ["trim"] },
      "body.seconds": { "kind": "field", "field_key": "seconds", "transforms": ["trim"] },
      "body.size": { "kind": "field", "field_key": "size", "transforms": ["trim"] },
      "body.input_reference": {
        "$if": { "$slot_present": "first_frame" },
        "then": {
          "kind": "when",
          "condition": { "op": "ne", "field": "inputReference", "value": [] },
          "truthy": {
            "kind": "field",
            "field_key": "inputReference",
            "transforms": ["extractFirstFile"],
            "media_target": "multipart_file"
          },
          "falsy": { "kind": "literal", "value": null }
        }
      },
      "body.last_frame": {
        "$if": { "$slot_present": "last_frame" },
        "then": {
          "kind": "when",
          "condition": { "op": "ne", "field": "lastFrame", "value": [] },
          "truthy": {
            "kind": "field",
            "field_key": "lastFrame",
            "transforms": ["extractFirstFile"],
            "media_target": "multipart_file"
          },
          "falsy": { "kind": "literal", "value": null }
        }
      },
      "body.reference_image": {
        "$if": { "$slot_present": "reference_image" },
        "then": {
          "kind": "when",
          "condition": { "op": "ne", "field": "referenceImage", "value": [] },
          "truthy": {
            "kind": "field",
            "field_key": "referenceImage",
            "transforms": ["allUploadFiles"],
            "media_target": "multipart_file",
            "multipart_array_naming": "repeated"
          },
          "falsy": { "kind": "literal", "value": null }
        }
      },
      "prompt": { "kind": "field", "field_key": "__prompt", "transforms": ["trim"] },
      "input": { "kind": "field", "field_key": "__prompt", "transforms": ["trim"] },
      "meta.model_id": { "kind": "literal", "value": "{{model_id}}" },
      "meta.seconds": { "kind": "field", "field_key": "seconds" },
      "meta.size": { "kind": "field", "field_key": "size" }
    }
  },
  "parameters": {
    "schema": {
      "schema_type": "object",
      "fields": [
        {
          "field_key": "seconds",
          "label": "fields.seconds.label",
          "description": "fields.seconds.description",
          "required": false,
          "validation_rules": [],
          "layout": {
            "colSpan": 1
          },
          "component": "select",
          "enum_options": [
            { "value": "4", "label": "fields.seconds.options.seconds_4.label" },
            { "value": "8", "label": "fields.seconds.options.seconds_8.label" },
            { "value": "12", "label": "fields.seconds.options.seconds_12.label" },
            { "value": "16", "label": "fields.seconds.options.seconds_16.label" },
            { "value": "20", "label": "fields.seconds.options.seconds_20.label" }
          ],
          "component_props": {}
        },
        {
          "field_key": "size",
          "label": "fields.size.label",
          "description": "fields.size.description",
          "required": false,
          "validation_rules": [],
          "layout": {
            "colSpan": 1
          },
          "component": "select",
          "enum_options": [
            { "value": "1280x720", "label": "fields.size.options.preset_1280x720.label" },
            { "value": "720x1280", "label": "fields.size.options.preset_720x1280.label" },
            { "value": "1920x1080", "label": "fields.size.options.preset_1920x1080.label" },
            { "value": "1080x1920", "label": "fields.size.options.preset_1080x1920.label" }
          ],
          "component_props": {}
        }
      ],
      "required_fields": [],
      "validation_rules": []
    },
    "defaults": {
      "seconds": "4",
      "size": "1280x720"
    },
    "prompt_field": {
      "field_key": "__prompt",
      "required": true,
      "validation_rules": []
    }
  },
  "media": {
    "supports": ["first_frame", "last_frame", "reference_image"],
    "required": [],
    "slots": {
      "first_frame": {
        "field_key": "inputReference",
        "component": "imageUpload",
        "wire_name": "input_reference",
        "max_files": 1
      },
      "last_frame": {
        "field_key": "lastFrame",
        "component": "imageUpload",
        "wire_name": "last_frame",
        "max_files": 1
      },
      "reference_image": {
        "field_key": "referenceImage",
        "component": "imageUpload",
        "wire_name": "reference_image",
        "max_files": 1
      }
    }
  },
  "projection": {
    "provider_id": "openai",
    "group_key": "openai",
    "capability": {
      "input_modalities": {
        "$if": { "$slot_present": "first_frame" },
        "then": ["text", "image"],
        "else": {
          "$if": { "$slot_present": "last_frame" },
          "then": ["text", "image"],
          "else": {
            "$if": { "$slot_present": "reference_image" },
            "then": ["text", "image"],
            "else": ["text"]
          }
        }
      },
      "output_modalities": ["video"],
      "supports_async_task": true,
      "supports_streaming": false,
      "supports_multi_image": false,
      "supports_reference_media": {
        "$if": { "$slot_present": "first_frame" },
        "then": true,
        "else": {
          "$if": { "$slot_present": "last_frame" },
          "then": true,
          "else": {
            "$if": { "$slot_present": "reference_image" },
            "then": true,
            "else": false
          }
        }
      },
      "constraints": []
    },
    "execution_profile": {
      "task_type": "video",
      "supports_async_task": true
    },
    "display": {
      "visible": true,
      "order": 9000
    },
    "workspace": {
      "task_list_position": "right"
    },
    "execution_driver": "http_formal_task",
    "node": {
      "node_type": "model",
      "output_ports": [
        {
          "id": "video",
          "name": "ports.outputs.video.name",
          "data_type": "video",
          "field_key": "output_video",
          "multiple": true,
          "description": "ports.outputs.video.description"
        }
      ]
    }
  },
  "builtin_behavior": {
    "result_rule": {
      "mode": "async"
    },
    "polling_status": {
      "status_paths": ["status", "data.status", "state"],
      "success_values": ["completed", "succeeded", "success", "done"],
      "failure_values": ["failed", "error", "cancelled", "canceled"],
      "failure_code_paths": ["error.code", "data.error.code"],
      "failure_message_paths": ["error.message", "message", "data.error.message"]
    },
    "result_output_mapping": {
      "response_mode": "structured_payload",
      "requires_auth": true,
      "output_mapping_rules": [
        {
          "target": "output.video_url",
          "source": {
            "kind": "response",
            "path": "__acquired_media_url"
          },
          "required": true
        }
      ],
      "note": "openai-video-v1 family template: binary final result is materialized by the acquisition stage"
    },
    "result_acquisition": {
      "acquisition_mode": "fetch_final_result",
      "identity_source": "remote_request_id",
      "request_strategy": {
        "request_stage": "acquisition",
        "protocol": "http",
        "endpoint": "/v1/videos/{id}/content",
        "method": "GET"
      },
      "accept": "binary",
      "media_type": "video",
      "requires_auth": true,
      "note": "openai-video-v1 family template: GET /v1/videos/{id}/content (binary, same-origin credential)"
    }
  },
  "composition": {
    "fragments": {
      "first_frame": {
        "schema_field": {
          "label": "fields.inputReference.label",
          "description": "fields.inputReference.description",
          "required": false,
          "default_value": [],
          "validation_rules": [],
          "layout": {
            "colSpan": 1
          },
          "component_props": {
            "accept": "image/*",
            "allowMultiple": false
          }
        },
        "input_port": {
          "id": "inputReference",
          "name": "ports.inputs.inputReference.name",
          "data_type": "image",
          "required": false,
          "max_connections": 1,
          "description": "ports.inputs.inputReference.description"
        }
      },
      "last_frame": {
        "schema_field": {
          "label": "fields.lastFrame.label",
          "description": "fields.lastFrame.description",
          "required": false,
          "default_value": [],
          "validation_rules": [],
          "layout": {
            "colSpan": 1
          },
          "component_props": {
            "accept": "image/*",
            "allowMultiple": false
          }
        },
        "input_port": {
          "id": "lastFrame",
          "name": "ports.inputs.lastFrame.name",
          "data_type": "image",
          "required": false,
          "max_connections": 1,
          "description": "ports.inputs.lastFrame.description"
        }
      },
      "reference_image": {
        "schema_field": {
          "label": "fields.referenceImage.label",
          "description": "fields.referenceImage.description",
          "required": false,
          "default_value": [],
          "validation_rules": [],
          "layout": {
            "colSpan": 1
          },
          "component_props": {
            "accept": "image/*",
            "allowMultiple": false
          }
        },
        "input_port": {
          "id": "referenceImage",
          "name": "ports.inputs.referenceImage.name",
          "data_type": "image",
          "required": false,
          "max_connections": 1,
          "description": "ports.inputs.referenceImage.description"
        }
      }
    },
    "variants": []
  },
  "localization": {
    "zh-CN": {
      "fields": {
        "prompt": {
          "label": "提示词"
        },
        "inputReference": {
          "label": "首帧",
          "description": "作为视频起始画面；不选择时按纯文生视频提交。"
        },
        "lastFrame": {
          "label": "尾帧",
