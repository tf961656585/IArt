          "label": "视频时长",
          "description": "不同服务支持的时长档位不同；可在模型参数中调整可选项。",
          "options": {
            "seconds_4": { "label": "4 秒" },
            "seconds_8": { "label": "8 秒" },
            "seconds_12": { "label": "12 秒" },
            "seconds_16": { "label": "16 秒" },
            "seconds_20": { "label": "20 秒" }
          }
        },
        "size": {
          "label": "画面尺寸",
          "description": "不同服务支持的尺寸不同；可在模型参数中调整可选项。",
          "options": {
            "preset_1280x720": { "label": "1280×720" },
            "preset_720x1280": { "label": "720×1280" },
            "preset_1920x1080": { "label": "1920×1080" },
            "preset_1080x1920": { "label": "1080×1920" }
          }
        }
      },
      "ports": {
        "inputs": {
